:root {
    --bg: #101010;          /* page background            */
    --bg-dark: #080808;     /* header + footer background  */
    --band: #191919;        /* shaded section background   */
    --card: #1c1c1c;        /* value card background       */
    --tile: #242424;        /* audience tile background    */

    --white: #ffffff;
    --text-soft: #dddddd;
    --text-mid: #cccccc;
    --text-dim: #aaaaaa;

    --red: #ed1c24;         /* main brand red              */
    --red-bright: #ff3038;  /* headings / eyebrow red      */
    --red-deep: #e51b23;    /* header rule                 */
    --red-glow: #e51b2355;  /* disc glow (last 2 = opacity)*/

    --border: #3a3a3a;
    --tile-border: #454545;
}

/* ---------- 2. Base ---------- */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--bg);
    color: var(--white);
    line-height: 1.7;
}

/* ---------- 3. Header & navigation ---------- */
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 8%;
    background: var(--bg-dark);
    border-bottom: 2px solid var(--red-deep);
}

.brand {
    color: var(--white);
    font-size: 27px;
    font-weight: 900;
    letter-spacing: 2px;
    text-decoration: none;
}

.brand span {
    color: var(--red);
}

nav {
    display: flex;
    gap: 25px;
}

nav a {
    color: var(--white);
    text-decoration: none;
    font-size: 14px;
    font-weight: bold;
}

nav a:hover {
    color: var(--red);
}

/* ---------- 4. Hero ---------- */
.hero {
    min-height: 580px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    padding: 70px 8%;
    background: linear-gradient(120deg, #111111, #351014, #111111);
}

.hero-content {
    flex: 1;
    max-width: 620px;
}

.eyebrow {
    color: var(--red-bright);
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 4px;
    margin-bottom: 18px;
}

h1 {
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1.12;
    margin-bottom: 24px;
    font-weight: 900;
}

.intro {
    color: var(--text-soft);
    font-size: 17px;
    max-width: 550px;
    margin-bottom: 32px;
}

.button {
    display: inline-block;
    background: var(--red);
    color: var(--white);
    padding: 14px 25px;
    text-decoration: none;
    font-size: 13px;
    font-weight: bold;
    border-radius: 4px;
}

.button:hover {
    background: var(--white);
    color: var(--red);
}

/* Bear artwork: the red disc, and the product photo when you use one. */
.bear-art {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    min-width: 0;
    overflow: hidden;
}

.bear-circle {
    width: 310px;
    height: 310px;
    padding: 20px;
    border-radius: 50%;
    background: radial-gradient(circle, #f13b40, #920d15 65%, #35090c);
    border: 5px solid #ff454b;
    box-shadow: 0 0 50px var(--red-glow);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.bear-face {
    font-size: 115px;
    line-height: 1.4;
}

.bear-circle p {
    font-size: 27px;
    font-weight: 900;
    letter-spacing: 4px;
}

.bear-circle span {
    font-size: 10px;
    letter-spacing: 2px;
    margin-top: 5px;
}

.bear-image {
    display: block;
    width: 100%;
    max-width: 180px;
    height: 240px;
    object-fit: contain;
    margin: 0 auto;
}

/* ---------- 5. Sections ---------- */
.section {
    padding: 85px 8%;
    text-align: center;
}

.section h2 {
    font-size: clamp(28px, 4vw, 42px);
    line-height: 1.2;
    margin-bottom: 25px;
}

.section > p:not(.eyebrow) {
    max-width: 780px;
    margin: 0 auto 35px;
    color: var(--text-mid);
}

/* ---------- 6. Values cards ---------- */
.values {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin-top: 45px;
}

.values article {
    background: var(--card);
    border: 1px solid var(--border);
    border-top: 4px solid var(--red);
    padding: 30px 20px;
    border-radius: 6px;
}

.values h3 {
    color: var(--red-bright);
    margin-bottom: 12px;
}

.values p {
    color: var(--text-mid);
}

/* ---------- 7. Audience grid ---------- */
.audience {
    background: var(--band);
}

.audience-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    max-width: 850px;
    margin: 35px auto 0;
}

.audience-grid div {
    padding: 25px 15px;
    background: var(--tile);
    border: 1px solid var(--tile-border);
    border-radius: 5px;
    font-weight: bold;
    letter-spacing: 1px;
}

.audience-grid div:hover {
    background: var(--red);
    border-color: var(--red);
}

/* ---------- 8. Footer ---------- */
footer {
    text-align: center;
    padding: 35px 20px;
    background: var(--bg-dark);
    border-top: 2px solid var(--red);
}

footer p {
    color: var(--text-dim);
    font-size: 13px;
    margin-top: 8px;
}

/* ---------- 9. Smaller screens ---------- */

/* Slightly wider phones: keep the product photo compact. */
@media (max-width: 768px) {
    .bear-image {
        max-width: 200px;
        max-height: 280px;
    }
}

/* Phones: stack the header, hero and both card grids. */
@media (max-width: 700px) {
    .header {
        flex-direction: column;
        gap: 18px;
        padding: 20px;
    }

    nav {
        justify-content: center;
        flex-wrap: wrap;
        gap: 18px;
    }

    .hero {
        flex-direction: column;
        text-align: center;
        padding: 55px 7%;
    }

    .intro {
        margin-left: auto;
        margin-right: auto;
    }

    .bear-circle {
        width: 250px;
        height: 250px;
    }

    .values {
        grid-template-columns: 1fr;
    }

    .audience-grid {
        grid-template-columns: 1fr;
    }
}

/* ---------- 10. Respect reduced-motion settings ---------- */
@media (prefers-reduced-motion: reduce) {
    html {
        scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
        animation: none !important;
        transition: none !important;
    }
}
