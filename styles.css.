* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #101010;
    color: #ffffff;
    line-height: 1.7;
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 8%;
    background: #080808;
    border-bottom: 2px solid #e51b23;
}

.brand {
    color: #ffffff;
    font-size: 27px;
    font-weight: 900;
    letter-spacing: 2px;
    text-decoration: none;
}

.brand span {
    color: #ed1c24;
}

nav {
    display: flex;
    gap: 25px;
}

nav a {
    color: #ffffff;
    text-decoration: none;
    font-size: 14px;
    font-weight: bold;
}

nav a:hover {
    color: #ed1c24;
}

.hero {
    min-height: 580px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    padding: 70px 8%;
    background: linear-gradient(120deg, #111111, #351014, #111111);
}

.hero-content {
    flex: 1;
    max-width: 620px;
}

.eyebrow {
    color: #ff3038;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 4px;
    margin-bottom: 18px;
}

h1 {
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1.12;
    margin-bottom: 24px;
    font-weight: 900;
}

.intro {
    color: #dddddd;
    font-size: 17px;
    max-width: 550px;
    margin-bottom: 32px;
}

.button {
    display: inline-block;
    background: #ed1c24;
    color: #ffffff;
    padding: 14px 25px;
    text-decoration: none;
    font-size: 13px;
    font-weight: bold;
    border-radius: 4px;
}

.button:hover {
    background: #ffffff;
    color: #ed1c24;
}

.bear-art {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
}

.bear-circle {
    width: 310px;
    height: 310px;
    border-radius: 50%;
    background: radial-gradient(circle, #f13b40, #920d15 65%, #35090c);
    border: 5px solid #ff454b;
    box-shadow: 0 0 50px #e51b2355;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.bear-face {
    font-size: 115px;
    line-height: 1.4;
}

.bear-circle p {
    font-size: 27px;
    font-weight: 900;
    letter-spacing: 4px;
}

.bear-circle span {
    font-size: 10px;
    letter-spacing: 2px;
    margin-top: 5px;
}

.section {
    padding: 85px 8%;
    text-align: center;
}

.section h2 {
    font-size: clamp(28px, 4vw, 42px);
    line-height: 1.2;
    margin-bottom: 25px;
}

.section > p:not(.eyebrow) {
    max-width: 780px;
    margin: 0 auto 35px;
    color: #cccccc;
}

.values {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin-top: 45px;
}

.values article {
    background: #1c1c1c;
    border: 1px solid #3a3a3a;
    border-top: 4px solid #ed1c24;
    padding: 30px 20px;
    border-radius: 6px;
}

.values h3 {
    color: #ff3038;
    margin-bottom: 12px;
}

.values p {
    color: #cccccc;
}

.audience {
    background: #191919;
}

.audience-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    max-width: 850px;
    margin: 35px auto 0;
}

.audience-grid div {
    padding: 25px 15px;
    background: #242424;
    border: 1px solid #454545;
    border-radius: 5px;
    font-weight: bold;
    letter-spacing: 1px;
}

.audience-grid div:hover {
    background: #ed1c24;
    border-color: #ed1c24;
}

footer {
    text-align: center;
    padding: 35px 20px;
    background: #080808;
    border-top: 2px solid #ed1c24;
}

footer p {
    color: #aaaaaa;
    font-size: 13px;
    margin-top: 8px;
}

@media (max-width: 700px) {
    .header {
        flex-direction: column;
        gap: 18px;
        padding: 20px;
    }

    nav {
        justify-content: center;
        flex-wrap: wrap;
        gap: 18px;
    }

    .hero {
        flex-direction: column;
        text-align: center;
        padding: 55px 7%;
    }

    .intro {
        margin-left: auto;
        margin-right: auto;
    }

    .bear-circle {
        width: 250px;
        height: 250px;
    }

   
